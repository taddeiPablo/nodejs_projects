extends ../layout-dashboard

block content
  h1 Perfil de usuario

  .card.mb-4
    .card-body
      h4 Información personal

      // Avatar
      if avatarUrl
        img(src=avatarUrl, alt="Avatar", style="width:120px; height:120px; border-radius:50%; object-fit:cover; margin-bottom:10px;")
      else
        div(style="width:120px; height:120px; border-radius:50%; background:#ddd; display:flex; align-items:center; justify-content:center; margin-bottom:10px;")
          span.text-muted Sin avatar

      form(method="POST", enctype="multipart/form-data")
        .mb-3
          label.form-label Subir nuevo avatar
          input.form-control(type="file", name="avatar")

        .mb-3
          label.form-label Biografía
          textarea.form-control(name="bio")= profile.bio || ""

        p.text-muted Email: #{profile.email || "No disponible"}

        button.btn.btn-primary(type="submit") Guardar cambios
