extends ../layout-dashboard

block content
  h1 API Key creada con éxito 🎉

  p.text-muted Copiala ahora — no volverá a mostrarse.

  .alert.alert-warning
    strong IMPORTANTE:
    |  Esta clave se mostrará solo una vez. Guardala en un lugar seguro.

  input#keyInput.form-control(type="password", value=rawKey, readonly)

  button#copyBtn.btn.btn-primary.mt-3 Copiar

  a.btn.btn-secondary.mt-3(href="/api-keys") ← Volver

block scripts
  script.
    document.addEventListener("DOMContentLoaded", () => {
      console.log("👉 Script cargado");
    
      const btn = document.getElementById("copyBtn");
      const inp = document.getElementById("keyInput");
    
      console.log("btn:", btn);
      console.log("inp:", inp);
    
      if (!btn || !inp) {
        console.warn("❌ No se encontraron elementos para el copiado");
        return;
      }
    
      btn.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(inp.value);
          btn.textContent = "¡Copiado!";
          btn.classList.replace("btn-primary", "btn-success");
    
          setTimeout(() => {
            btn.textContent = "Copiar";
            btn.classList.replace("btn-success", "btn-primary");
          }, 1500);
        } catch (e) {
          console.error("Error en copiar:", e);
        }
      });
    });

