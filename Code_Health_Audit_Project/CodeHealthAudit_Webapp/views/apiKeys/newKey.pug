extends ../layout-dashboard

block content
  h1 Crear nueva API Key

  .alert.alert-warning
    strong IMPORTANTE:
    |  La clave se mostrará solo una vez después de generarla.

  form(method="POST", action="/api-keys/create")
    .mb-3
      label.form-label Nombre / Etiqueta
      input.form-control(type="text", name="label", required)

    .mt-4
      button.btn.btn-primary(type="submit") Crear API Key
      a.btn.btn-secondary.ms-2(href="/api-keys") Cancelar
