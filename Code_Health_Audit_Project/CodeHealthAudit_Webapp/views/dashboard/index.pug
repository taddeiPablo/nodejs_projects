extends ../layout-dashboard

block content
  h1 Dashboard
  p.text-muted Hola #{user.email}, este es tu panel principal.

  // ----- CARDS DE RESUMEN -----
  .row.mt-4
    .col-md-4
      .card.shadow-sm
        .card-body
          h5.card-title 📊 Reportes Totales
          p.display-6 #{totalReports}
          a.btn.btn-primary.mt-2(href="/reports") Ver reportes

    .col-md-4
      .card.shadow-sm
        .card-body
          h5.card-title 🔑 API Keys Activas
          p.display-6 #{totalApiKeys}
          a.btn.btn-secondary.mt-2(href="/api-keys") Gestionar keys

    .col-md-4
      .card.shadow-sm
        .card-body
          h5.card-title 🕒 Último Reporte
          if latestReport
            p.text-muted #{latestReport.created_at}
            a.btn.btn-outline-primary.mt-2(href="/reports") Ver detalles
          else
            p.text-muted No hay reportes aún.

  hr.mt-5

  // ----- ACTIVIDAD RECIENTE -----
  h3 Actividad reciente

  if recentReports && recentReports.length
    table.table.table-striped.mt-3
      thead
        tr
          th ID
          th Fecha
          th Path
      tbody
        each r in recentReports
          tr
            td= r.id
            td= r.created_at
            td= r.project_path
  else
    p.text-muted No hay reportes recientes.
